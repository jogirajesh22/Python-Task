#Combine all the characters from the given sentence in which the respective indices are         divisible by 5 and ignore the space in output.
#Example : #input : Winners are not those who never fail but those who never quit
 #               #output:  Wreerlert
input ="Winners are not those who never fail but those who never quit"
input=input.replace( "" ,"")
result = ""
for i in range (len(input)):
    if i % 5==0:
        result = result + input[i]
print("output:",result)
