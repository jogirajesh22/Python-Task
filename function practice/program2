"""
2.Write a python Function called multiply to multiply all of the numbers
in a list together and return that value.The function should be created
in such a way that it will work for both lists,tuples, and sets.
"""
def Multiply(numbers):
    result=1
    for num in numbers:
       result=result*num
    return result
print(Multiply((1,2,3)))
print(Multiply([3,5,6,7]))
print(Multiply({3,6,9}))