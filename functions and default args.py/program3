def student_grade(name,marks):
    total=0
    for mark in marks:
        total=total+mark


    average =total/5

    if average>=90:
        grade='A'
    elif average>=75:
        grade='B'
    elif average >=60:
        grade='C'
    elif average >=45:
        grade ="D"    
    else:
        grade='F'
    return total,average,grade

